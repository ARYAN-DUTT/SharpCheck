generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(uuid())
  name           String
  email          String             @unique
  passwordHash   String
  createdAt      DateTime           @default(now())
  reports        ComplianceReport[]
}

model ComplianceReport {
  id             String   @id @default(uuid())
  productName    String?
  imageUrl       String?
  isCompliant    Boolean
  missingFields  String   // JSON stringified array of parameter objects
  observations   String
  createdAt      DateTime @default(now())
  
  // Relation to User
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?
}
